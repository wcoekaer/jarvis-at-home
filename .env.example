# Copy to .env and chmod 600. Read by jarvis.py, install.sh and the JarvisHome
# bridge. launchd services don't see your shell environment, so keys live here.
# .env is git-ignored: never commit it.

# --- language model + speech (at least one) ---
OPENAI_API_KEY=            # briefings (llm.provider: openai) and voice (tts.engine: openai)
ANTHROPIC_API_KEY=         # if llm.provider: anthropic

# --- MQTT broker (home data: Powerpack, UniFi, HomeKit bridge, weather station...) ---
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_PORT=1883

# --- optional data sources ---
AIRSPACE_URL=              # OSP airspace server REST API, e.g. https://host:18771
AIRSPACE_API_KEY=
TRAFFIC_API_KEY=           # 511.org open data token (free): https://511.org/open-data/token
IQAIR_API_KEY=             # IQAir AirVisual, free Community plan

# --- JarvisHome (HomeKit -> MQTT bridge) code signing ---
JARVIS_TEAM_ID=            # Apple developer team id (Xcode > Settings > Accounts)
JARVIS_BUNDLE_PREFIX=      # reverse-DNS prefix you own, e.g. com.example
